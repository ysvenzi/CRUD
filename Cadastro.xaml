<Window x:Class="CRUD.Cadastro"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="orkut - Criar Conta"
        Height="800" Width="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F4EFEA" FontFamily="Segoe UI">
    
    <Grid>
        <!-- Fundo em Gradiente padrão do Orkut -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F9F6F0" Offset="0.0" />
                <GradientStop Color="#E6DEC9" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">

            <!-- Logo clássica do Orkut -->
            <TextBlock Text="orkut!" 
                       FontSize="42" 
                       FontWeight="Bold" 
                       Foreground="#7B583E" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,2">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="2" ShadowDepth="2" Color="#D2B48C" Opacity="0.5"/>
                </TextBlock.Effect>
            </TextBlock>
            
            <!-- Subtítulo de Contexto -->
            <TextBlock Text="crie uma conta para começar"
                       FontSize="13"
                       Foreground="#9C7A5F"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"
                       FontStyle="Italic"/>

            <!-- Card de Formulário -->
            <Border Background="White"
                    BorderBrush="#D5C5B5"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="30">

                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Color="#8B7355" Opacity="0.15" />
                </Border.Effect>

                <StackPanel>

                    <!-- Campo: Nome -->
                    <TextBlock Text="Nome"
                               Foreground="#5A4535"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Margin="0,0,0,5" />
                    <TextBox x:Name="TxtNome"
                             Height="35"
                             Padding="8,5,8,5"
                             BorderBrush="#D5C5B5"
                             BorderThickness="1"
                             Margin="0,0,0,15"
                             VerticalContentAlignment="Center" />

                    <!-- Campo: Username -->
                    <TextBlock Text="Username"
                               Foreground="#5A4535"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Margin="0,0,0,5" />
                    <TextBox x:Name="TxtUsername"
                             Height="35"
                             Padding="8,5,8,5"
                             BorderBrush="#D5C5B5"
                             BorderThickness="1"
                             Margin="0,0,0,15"
                             VerticalContentAlignment="Center" />
                    
                    <!-- Campo: E-mail -->
                    <TextBlock Text="E-mail"
                               Foreground="#5A4535"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Margin="0,0,0,5" />
                    <TextBox x:Name="TxtEmail"
                             Height="35"
                             Padding="8,5,8,5"
                             BorderBrush="#D5C5B5"
                             BorderThickness="1"
                             Margin="0,0,0,15"
                             VerticalContentAlignment="Center" />
                    
                    <!-- Campo: Senha -->
                    <TextBlock Text="Senha"
                               Foreground="#5A4535"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Margin="0,0,0,5" />
                    <PasswordBox x:Name="TxtSenha"
                                 Height="35"
                                 Padding="8,5,8,5"
                                 BorderBrush="#D5C5B5"
                                 BorderThickness="1"
                                 Margin="0,0,0,25"
                                 VerticalContentAlignment="Center" />

                    <!-- Botão Cadastrar -->
                    <Button x:Name="BtnCadastrar"
                            Content="Cadastrar"
                            Height="40"
                            Background="#7B583E"
                            Foreground="White"
                            FontWeight="Bold"
                            FontSize="14"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="BtnCadastrar_OnClick">
                        <Button.Resources>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#5C402D" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Resources>
                    </Button>

                </StackPanel>
            </Border>

            <!-- Rodapé corporativo padrão -->
            <TextBlock Text="© 2004 - 2026 orkut paródia inc."
                       FontSize="11"
                       Foreground="#A89482"
                       HorizontalAlignment="Center"
                       Margin="0,15,0,0" />
        </StackPanel>
    </Grid>
</Window>