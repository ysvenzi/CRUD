<Window x:Class="CRUD.Feed"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:modelos="clr-namespace:CRUD.Modelos"
        mc:Ignorable="d"
        Title="orkut - Feed de Notícias" Height="680" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#F4EFEA" FontFamily="Segoe UI">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F9F6F0" Offset="0.0" />
                <GradientStop Color="#E6DEC9" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.Resources>
            <Style x:Key="BotaoFlutuanteMarrom" TargetType="Button">
                <Setter Property="Background" Value="#7B583E" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse Fill="{TemplateBinding Background}">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="3" Color="#422405" Opacity="0.3" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="0,0,0,4" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#9C7A5F" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="#5C402B" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Grid.Resources>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="440">

            <TextBlock Text="orkut!"
                       FontSize="42"
                       FontWeight="Bold"
                       Foreground="#7B583E"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,2">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="2" ShadowDepth="2" Color="#D2B48C" Opacity="0.5" />
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock Text="veja o que seus amigos estão compartilhando"
                       FontSize="13"
                       Foreground="#9C7A5F"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"
                       FontStyle="Italic" />

            <Border Background="White"
                    BorderBrush="#D5C5B5"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="25"
                    Width="420"
                    Height="480">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Color="#8B7355" Opacity="0.15" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Feed Social"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#422405"
                               Margin="0,0,0,15"
                               HorizontalAlignment="Center" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl x:Name="ItemsControlFeed">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type modelos:Postagem}">
                                        <Border BorderBrush="#E6DEC9" BorderThickness="0,0,0,1" Margin="0,0,0,15"
                                                Padding="0,0,0,15">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,10">
                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                        <TextBlock Text="{Binding Usuario.Nome}"
                                                                   FontWeight="Bold"
                                                                   FontSize="14"
                                                                   Foreground="#7B583E" />
                                                        <TextBlock
                                                            Text="{Binding Usuario.Username, StringFormat='@{0}' }"
                                                            Foreground="#A89482"
                                                            FontSize="13"
                                                            Margin="6,0,0,0"
                                                            VerticalAlignment="Bottom" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Text="{Binding PostadoEm, StringFormat='dd MMM - HH:mm'}"
                                                        Foreground="#9C7A5F"
                                                        FontSize="11"
                                                        FontStyle="Italic"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center" />
                                                </DockPanel>

                                                <TextBlock Text="{Binding Conteudo}"
                                                           TextWrapping="Wrap"
                                                           FontSize="13"
                                                           Foreground="#4A4139"
                                                           LineHeight="18"
                                                           Margin="0,0,0,12" />

                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="❤️ Curtir"
                                                            Height="30"
                                                            Width="90"
                                                            HorizontalAlignment="Left"
                                                            FontWeight="SemiBold"
                                                            FontSize="12"
                                                            BorderThickness="1"
                                                            BorderBrush="#D5C5B5"
                                                            Cursor="Hand"
                                                            Click="BtnCurtir_OnClick"
                                                            Tag="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="#EDF2F7" />
                                                                <Setter Property="Foreground" Value="#7B583E" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding FoiCurtido}"
                                                                            Value="True">
                                                                        <Setter Property="Background" Value="#FFF5F5" />
                                                                        <Setter Property="Foreground" Value="#C53030" />
                                                                        <Setter Property="BorderBrush" Value="#E53E3E" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="4" />
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>

                                                    <TextBlock VerticalAlignment="Center"
                                                               FontSize="12"
                                                               Foreground="#8B7355"
                                                               Margin="10,0"
                                                               Text="{Binding Curtidas, StringFormat='{}{0} curtidas'}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <TextBlock Text="© 2004 - 2026 orkut paródia inc."
                       FontSize="11"
                       Foreground="#A89482"
                       HorizontalAlignment="Center"
                       Margin="0,15,0,0" />
        </StackPanel>

        <Button Style="{StaticResource BotaoFlutuanteMarrom}"
                Width="56" Height="56"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,30,100"
                Click="BtnPerfil_OnClick"
                ToolTip="Ir para o Perfil">
            <TextBlock Text="👤" FontSize="20" FontWeight="Normal" Foreground="White" />
        </Button>

        <Button Style="{StaticResource BotaoFlutuanteMarrom}"
                Width="56" Height="56"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,30,30"
                Click="BtnNovoPost_OnClick"
                ToolTip="Adicionar nova postagem">
            <TextBlock Text="+" FontSize="28" FontWeight="Light" Foreground="White" />
        </Button>

    </Grid>
</Window>