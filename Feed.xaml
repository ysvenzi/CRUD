<Window x:Class="CRUD.Feed"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:modelos="clr-namespace:CRUD.Modelos"
        mc:Ignorable="d"
        Title="orkut - Feed de Notícias" Height="800" Width="750"
        WindowStartupLocation="CenterScreen"
        Background="#F4EFEA" FontFamily="Segoe UI">
    
    <Grid>
        <!-- Fundo em Gradiente idêntico ao padrão do seu app -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F9F6F0" Offset="0.0"/>
                <GradientStop Color="#E6DEC9" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="480">
            
            <!-- Cabeçalho do Orkut -->
            <TextBlock Text="orkut!" 
                       FontSize="42" 
                       FontWeight="Bold" 
                       Foreground="#7B583E" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,2">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="2" ShadowDepth="2" Color="#D2B48C" Opacity="0.5"/>
                </TextBlock.Effect>
            </TextBlock>
            
            <TextBlock Text="veja o que seus amigos estão compartilhando" 
                       FontSize="13" 
                       Foreground="#9C7A5F" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,15" 
                       FontStyle="Italic"/>

            <!-- Caixa Principal do Feed -->
            <Border Background="White"
                    BorderBrush="#D5C5B5"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="25"
                    Height="600">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Color="#8B7355" Opacity="0.15" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Título interno estilizado -->
                    <TextBlock Grid.Row="0"
                               Text="Feed Social"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#422405"
                               Margin="0,0,0,15"
                               HorizontalAlignment="Center" />

                    <!-- ScrollViewer customizado para o tema -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Mantido o ItemsControl original para não quebrar o Code Behind -->
                            <ItemsControl x:Name="ItemsControlFeed">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type modelos:Postagem}">
                                        <!-- Post Card Divisor -->
                                        <Border BorderBrush="#E6DEC9" BorderThickness="0,0,0,1" Margin="0,0,0,15" Padding="0,0,0,15">
                                            <StackPanel>
                                                <!-- Cabeçalho do Post: Nome, @ e Data -->
                                                <DockPanel Margin="0,0,0,10">
                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                        <TextBlock Text="{Binding Usuario.Nome}"
                                                                   FontWeight="Bold"
                                                                   FontSize="14"
                                                                   Foreground="#7B583E" />
                                                        <TextBlock Text="{Binding Usuario.Username, StringFormat='@{0}' }"
                                                                   Foreground="#A89482"
                                                                   FontSize="13"
                                                                   Margin="6,0,0,0"
                                                                   VerticalAlignment="Bottom"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Postado_em, StringFormat='dd MMM - HH:mm'}"
                                                               Foreground="#9C7A5F"
                                                               FontSize="11"
                                                               FontStyle="Italic"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center" />
                                                </DockPanel>

                                                <!-- Conteúdo Textual do Post -->
                                                <TextBlock Text="{Binding Conteudo}"
                                                           TextWrapping="Wrap"
                                                           FontSize="13"
                                                           Foreground="#4A4139"
                                                           LineHeight="18"
                                                           Margin="0,0,0,12" />

                                                <!-- Área de Interações: Botão Curtir + Contador -->
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="❤️ Curtir"
                                                            Height="30"
                                                            Width="90"
                                                            HorizontalAlignment="Left"
                                                            FontWeight="SemiBold"
                                                            FontSize="12"
                                                            BorderThickness="1"
                                                            BorderBrush="#D5C5B5"
                                                            Cursor="Hand"
                                                            Click="BtnCurtir_OnClick"
                                                            Tag="{Binding}">
                                                        <!-- Lógica de Triggers Visual Preservada e Adaptada -->
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="#EDF2F7"/>
                                                                <Setter Property="Foreground" Value="#7B583E"/>
                                                                <!-- Altera as cores quando a postagem for curtida -->
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding FoiCurtido}" Value="True">
                                                                        <Setter Property="Background" Value="#FFF5F5"/>
                                                                        <Setter Property="Foreground" Value="#C53030"/>
                                                                        <Setter Property="BorderBrush" Value="#E53E3E"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="4" />
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                    
                                                    <!-- Contador de Curtidas -->
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontSize="12"
                                                               Foreground="#8B7355"
                                                               Margin="10,0"
                                                               Text="{Binding Curtidas, StringFormat='{}{0} curtidas'}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Rodapé corporativo padrão -->
            <TextBlock Text="© 2004 - 2026 orkut paródia inc." 
                       FontSize="11" 
                       Foreground="#A89482" 
                       HorizontalAlignment="Center" 
                       Margin="0,15,0,0"/>
        </StackPanel>
    </Grid>
</Window>