<Window x:Class="CRUD.Feed"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:modelos="clr-namespace:CRUD.Modelos"
        xmlns:utils="clr-namespace:CRUD.Utils"
        mc:Ignorable="d"
        Icon="Resources/icon.png"
        Title="orkut - Feed de Notícias" Height="900" Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#F4EFEA" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="BotaoSemBorda" TargetType="Button">
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <BooleanToVisibilityConverter x:Key="ConverteSuaPostagem" />
    </Window.Resources>

    <Window.DataContext>
        <utils:FeedViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#F9F6F0" Offset="0.0" />
                <GradientStop Color="#E6DEC9" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.Resources>
            <Style x:Key="BotaoFlutuanteMarrom" TargetType="Button">
                <Setter Property="Background" Value="#7B583E" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Ellipse Fill="{TemplateBinding Background}">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="3" Color="#422405" Opacity="0.3" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="0,0,0,4" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#9C7A5F" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="#5C402B" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Grid.Resources>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="440">

            <TextBlock Text="orkut!"
                       FontSize="42"
                       FontWeight="Bold"
                       Foreground="#7B583E"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,2">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="2" ShadowDepth="2" Color="#D2B48C" Opacity="0.5" />
                </TextBlock.Effect>
            </TextBlock>

            <TextBlock Text="veja o que seus amigos estão compartilhando"
                       FontSize="13"
                       Foreground="#9C7A5F"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"
                       FontStyle="Italic" />

            <Border Background="White"
                    BorderBrush="#D5C5B5"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="25"
                    Width="435"
                    Height="600">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Color="#8B7355" Opacity="0.15" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Feed Social"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#422405"
                               Margin="0,0,0,15"
                               HorizontalAlignment="Center" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Height="480" Width="380" HorizontalAlignment="Center">
                            <ItemsControl x:Name="ItemsControlFeed" ItemsSource="{Binding Postagens}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type modelos:Postagem}">
                                        <Border BorderBrush="#E6DEC9" BorderThickness="0,0,0,1" Margin="0,0,0,15"
                                                Padding="0,0,0,15">
                                            <StackPanel>
                                                <DockPanel Margin="0,0,0,10">
                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                                        <TextBlock Text="{Binding Usuario.Nome}"
                                                                   FontWeight="Bold"
                                                                   FontSize="14"
                                                                   Foreground="#7B583E" />
                                                        <TextBlock
                                                            Text="{Binding Usuario.Username, StringFormat='@{0}' }"
                                                            Foreground="#A89482"
                                                            FontSize="13"
                                                            Margin="6,0,0,0"
                                                            VerticalAlignment="Bottom" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        Text="{Binding PostadoEm, StringFormat='dd MMM - HH:mm'}"
                                                        Foreground="#9C7A5F"
                                                        FontSize="11"
                                                        FontStyle="Italic"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center" />
                                                </DockPanel>

                                                <TextBlock Text="{Binding Conteudo}"
                                                           TextWrapping="Wrap"
                                                           FontSize="13"
                                                           Foreground="#4A4139"
                                                           LineHeight="18"
                                                           Margin="0,0,0,12" />

                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="❤️ Curtir"
                                                            Height="30"
                                                            Width="90"
                                                            HorizontalAlignment="Left"
                                                            FontWeight="SemiBold"
                                                            FontSize="12"
                                                            BorderThickness="1"
                                                            BorderBrush="#D5C5B5"
                                                            Cursor="Hand"
                                                            Click="BtnCurtir_OnClick"
                                                            Tag="{Binding}">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="#EDF2F7" />
                                                                <Setter Property="Foreground" Value="#7B583E" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding FoiCurtido}"
                                                                            Value="True">
                                                                        <Setter Property="Background" Value="#FFF5F5" />
                                                                        <Setter Property="Foreground" Value="#C53030" />
                                                                        <Setter Property="BorderBrush" Value="#E53E3E" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="4" />
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>

                                                    <TextBlock VerticalAlignment="Center"
                                                               FontSize="12"
                                                               Foreground="#8B7355"
                                                               Margin="10,0"
                                                               Text="{Binding Curtidas, StringFormat='{}{0} curtidas'}" />

                                                    <StackPanel Orientation="Horizontal"
                                                                Visibility="{Binding SuaPostagem, Converter={StaticResource ConverteSuaPostagem}}">
                                                        <!-- Botão de apagar -->
                                                        <Button Background="Transparent"
                                                                Style="{StaticResource BotaoSemBorda}"
                                                                Margin="4,0"
                                                                Click="BtnApagarPostagem_OnClick"
                                                                Tag="{Binding Id}">
                                                            <Path
                                                                Data="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-280h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z"
                                                                Width="16"
                                                                Height="16"
                                                                Fill="#7B583E"
                                                                Stretch="Fill" />
                                                        </Button>

                                                        <!-- Botão de editar -->
                                                        <Button Background="Transparent"
                                                                Style="{StaticResource BotaoSemBorda}"
                                                                Margin="4,0"
                                                                Click="BtnEditarPostagem_OnClick"
                                                                Tag="{Binding}">
                                                            <Path
                                                                Data="M200-200h57l391-391-57-57-391 391v57Zm-80 80v-170l528-527q12-11 26.5-17t30.5-6q16 0 31 6t26 18l55 56q12 11 17.5 26t5.5 30q0 16-5.5 30.5T817-647L290-120H120Zm640-584-56-56 56 56Zm-141 85-28-29 57 57-29-28Z"
                                                                Width="16"
                                                                Height="16"
                                                                Fill="#7B583E"
                                                                Stretch="Fill" />
                                                        </Button>
                                                    </StackPanel>

                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <TextBlock Text="© 2004 - 2026 orkut paródia inc."
                       FontSize="11"
                       Foreground="#A89482"
                       HorizontalAlignment="Center"
                       Margin="0,15,0,0" />
        </StackPanel>

        <Button Style="{StaticResource BotaoFlutuanteMarrom}"
                Width="56" Height="56"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,30,100"
                Click="BtnPerfil_OnClick"
                ToolTip="Ir para o Perfil">
            <Path
                Data="M367-527q-47-47-47-113t47-113q47-47 113-47t113 47q47 47 47 113t-47 113q-47 47-113 47t-113-47ZM160-160v-112q0-34 17.5-62.5T224-378q62-31 126-46.5T480-440q66 0 130 15.5T736-378q29 15 46.5 43.5T800-272v112H160Zm80-80h480v-32q0-11-5.5-20T700-306q-54-27-109-40.5T480-360q-56 0-111 13.5T260-306q-9 5-14.5 14t-5.5 20v32Zm296.5-343.5Q560-607 560-640t-23.5-56.5Q513-720 480-720t-56.5 23.5Q400-673 400-640t23.5 56.5Q447-560 480-560t56.5-23.5ZM480-640Zm0 400Z"
                Width="24" Height="24"
                Fill="White"
                Stretch="Fill" />
        </Button>

        <Button Style="{StaticResource BotaoFlutuanteMarrom}"
                Width="56" Height="56"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,30,30"
                Click="BtnNovoPost_OnClick"
                ToolTip="Adicionar nova postagem">
            <Path
                Data="M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h357l-80 80H200v560h560v-278l80-80v358q0 33-23.5 56.5T760-120H200Zm280-360ZM360-360v-170l367-367q12-12 27-18t30-6q16 0 30.5 6t26.5 18l56 57q11 12 17 26.5t6 29.5q0 15-5.5 29.5T897-728L530-360H360Zm481-424-56-56 56 56ZM440-440h56l232-232-28-28-29-28-231 231v57Zm260-260-29-28 29 28 28 28-28-28Z"
                Width="24" Height="24"
                Fill="White"
                Stretch="Fill" />
        </Button>

    </Grid>
</Window>